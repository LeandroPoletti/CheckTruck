# Copie para .env (cp .env.exemplo .env) e preencha. O .env fica só no servidor: não vai para o Git.
# Nas senhas, não use o símbolo $ (o Docker entende como variável).

# Banco (RDS): troque ENDERECO_DO_RDS pelo "Endpoint" do banco no painel da AWS e SENHA_DO_BANCO pela senha dele
ConnectionStrings__DefaultConnection=Host=ENDERECO_DO_RDS;Port=5432;Database=checktruck;Username=checktruck;Password=SENHA_DO_BANCO;SSL Mode=Require

# Senha dos dois primeiros logins (admin@admin.com e dono@checktruck.com). Só vale na primeira vez que a API sobe.
# Pelo menos 6 caracteres, com letra maiúscula, minúscula, número e símbolo (ex.: @).
ContasIniciais__SenhaDoAdmin=
ContasIniciais__SenhaDoDono=
