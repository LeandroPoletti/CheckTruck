# Servidor web do CheckTruck (servidor/compose.yaml). O https fica no CloudFront, que fala com este servidor por
# http na porta 80. Daqui, /api e /hubs (o canal de mudanças, com WebSocket) vão para a API, e o resto é o site.
{
	admin off
	auto_https off
	servers {
		# Só o CloudFront chega aqui (grupo de segurança da AWS): o IP de quem acessou, que ele manda no
		# X-Forwarded-For, segue para a API
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		# Os arquivos de /assets mudam de nome a cada versão, então o navegador pode guardar. O resto, não.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pagina not path /assets/*
		header @pagina Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
